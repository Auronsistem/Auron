:root{--bg:#090d18;--panel:#11182a;--panel2:#171f34;--text:#f6f7fb;--muted:#9ba7bf;--neon:#c5ff35;--cyan:#46f4ff;--pink:#ff4fd8;--line:#26314b}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 75% 0%,#18234a 0,transparent 38%),var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.topbar{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(18px,5vw,76px);border-bottom:1px solid #202942;background:#090d18e8;position:sticky;top:0;z-index:5;backdrop-filter:blur(16px)}.brand{font-weight:900;letter-spacing:.04em;color:white;text-decoration:none;font-size:18px;white-space:nowrap}.brand b{color:var(--neon)}.brand-icon{display:inline-grid;place-items:center;width:30px;height:30px;background:var(--neon);color:#101525;border-radius:9px;margin-right:7px}.topbar nav{display:flex;gap:26px}.topbar nav a{color:var(--muted);text-decoration:none;font-size:14px}.topbar nav a:hover{color:var(--neon)}button,a{font:inherit}.button{display:inline-flex;align-items:center;justify-content:center;gap:12px;border:0;border-radius:12px;padding:13px 19px;background:var(--neon);color:#111626;font-weight:850;text-decoration:none;cursor:pointer;box-shadow:0 0 22px #c5ff3520;transition:transform .18s,box-shadow .18s}.button:hover{transform:translateY(-2px);box-shadow:0 0 28px #c5ff3545}.button-outline{border:1px solid #3c4966;background:transparent;color:var(--text);box-shadow:none;padding:10px 14px}.hero{min-height:480px;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:65px clamp(22px,8vw,120px);gap:30px;overflow:hidden}.eyebrow{font-size:11px;letter-spacing:.19em;font-weight:900;color:var(--neon);margin:0 0 14px}.hero h1{font-size:clamp(46px,6.6vw,82px);line-height:.98;letter-spacing:-.06em;margin:0 0 20px}.hero h1 span{color:var(--neon);text-shadow:0 0 35px #c5ff3530}.muted{color:var(--muted);line-height:1.7;max-width:470px}.hero-copy .button{margin-top:18px}.hero-art{height:330px;position:relative;display:grid;place-items:center;isolation:isolate}.hero-art:before{content:"";position:absolute;inset:20px 30px;border:1px solid #46f4ff50;transform:rotate(-8deg);border-radius:32px;box-shadow:0 0 80px #46f4ff15,inset 0 0 55px #46f4ff0d}.orb{position:absolute;border-radius:50%;filter:blur(2px);z-index:-1}.orb-one{width:200px;height:200px;background:#773bff55;left:14%;top:12%;box-shadow:0 0 80px #773bff55}.orb-two{width:150px;height:150px;background:#c5ff3530;right:9%;bottom:12%;box-shadow:0 0 65px #c5ff3530}.play-card{width:210px;height:240px;border:1px solid #c5ff3590;border-radius:25px;background:linear-gradient(145deg,#1c2840,#0c1120);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:23px;box-shadow:0 25px 80px #0009,0 0 35px #c5ff3520;transform:rotate(6deg)}.play-card span{display:grid;place-items:center;width:90px;height:90px;border-radius:26px;background:var(--neon);color:#101525;font-size:42px;padding-left:5px;box-shadow:0 0 45px #c5ff3560}.play-card small{letter-spacing:.15em;font-weight:900}.floating-tag{position:absolute;background:#11182a;border:1px solid #3d4b6b;padding:11px 14px;border-radius:10px;font-size:11px;font-weight:900;letter-spacing:.08em;box-shadow:0 10px 35px #0008}.tag-one{top:25px;right:2px;color:var(--neon);transform:rotate(5deg)}.tag-two{bottom:24px;left:0;color:var(--cyan)}.section{padding:35px clamp(20px,7vw,100px) 65px}.section-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:22px}.section h2,.account-panel h2{font-size:clamp(27px,4vw,40px);letter-spacing:-.04em;margin:0}.pill{font-size:10px;font-weight:900;color:var(--cyan);border:1px solid #46f4ff55;padding:7px 10px;border-radius:999px}.video-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.video-card{border:1px solid var(--line);border-radius:17px;overflow:hidden;background:#101629;transition:transform .2s,border-color .2s}.video-card:hover{transform:translateY(-4px);border-color:#c5ff3570}.thumb{height:175px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.thumb:before,.thumb:after{content:"";position:absolute;width:190px;height:190px;border:1px solid #ffffff35;transform:rotate(35deg);border-radius:38px}.thumb:after{width:130px;height:130px;transform:rotate(-25deg)}.thumb span{z-index:1;display:grid;place-items:center;width:55px;height:55px;border-radius:50%;background:#c5ff35;color:#111626;padding-left:3px;box-shadow:0 0 35px #c5ff3580}.thumb label{position:absolute;top:13px;left:13px;font-size:9px;font-weight:900;letter-spacing:.1em;background:#080c18a8;border:1px solid #ffffff40;padding:7px 9px;border-radius:6px}.thumb-purple{background:radial-gradient(circle at 50% 50%,#7939c9,#17152d 70%)}.thumb-blue{background:radial-gradient(circle at 50% 50%,#176eaa,#101b38 70%)}.thumb-pink{background:radial-gradient(circle at 50% 50%,#bd2b8e,#27132f 70%)}.video-meta{padding:15px}.video-meta h3{font-size:15px;margin:0 0 7px}.video-meta p,.notice{font-size:11px;color:var(--muted);line-height:1.6}.account-panel{margin:0 clamp(20px,7vw,100px) 30px;padding:30px;border:1px solid #c5ff3540;border-radius:20px;background:linear-gradient(110deg,#18223a,#11182a 65%);display:flex;align-items:center;justify-content:space-between;gap:22px}.account-panel h2{font-size:27px}.account-panel p{margin-bottom:0}.admin-note{margin:0 clamp(20px,7vw,100px) 60px;display:flex;gap:17px;padding:22px;border:1px solid var(--line);border-radius:16px;background:#0d1322}.admin-symbol{font-size:27px;color:var(--cyan)}.admin-note h3{margin:0 0 7px}.admin-note p{margin:0;color:var(--muted);font-size:13px;line-height:1.7}footer{border-top:1px solid #202942;padding:25px clamp(20px,5vw,76px);display:flex;justify-content:space-between;gap:15px;color:var(--muted);font-size:12px}dialog{width:min(420px,calc(100% - 28px));border:1px solid #35415d;border-radius:20px;background:#11182a;color:var(--text);padding:28px;box-shadow:0 25px 90px #000c}dialog::backdrop{background:#030611cc;backdrop-filter:blur(6px)}dialog h2{margin:0 0 10px}.dialog-close{display:flex;justify-content:flex-end}.dialog-close button{background:none;border:0;color:white;font-size:28px;cursor:pointer}dialog label{display:block;font-size:12px;margin:15px 0 7px}dialog input{width:100%;background:#090d18;color:white;border:1px solid #34415e;border-radius:10px;padding:13px;outline:none}dialog input:focus{border-color:var(--neon)}.full{width:100%;margin-top:20px}.text-button{margin-top:12px;background:none;color:var(--cyan);border:0;cursor:pointer;padding:8px 0}.notice{min-height:15px}@media(max-width:760px){.topbar{height:66px;padding:0 16px}.topbar nav{display:none}.topbar .button{font-size:12px}.hero{grid-template-columns:1fr;padding:55px 24px 30px;gap:0}.hero-art{height:280px;margin-top:10px}.hero h1{font-size:58px}.section{padding:28px 18px 45px}.video-grid{grid-template-columns:1fr;gap:14px}.thumb{height:190px}.account-panel{margin:0 18px 22px;padding:23px;align-items:flex-start;flex-direction:column}.admin-note{margin:0 18px 42px}footer{padding:22px 18px;flex-direction:column}.floating-tag.tag-one{right:0}.floating-tag.tag-two{left:0}}@media(min-width:761px) and (max-width:1000px){.hero{padding-left:5vw;padding-right:5vw}.video-grid{gap:12px}.thumb{height:140px}}
